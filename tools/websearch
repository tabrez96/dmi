#!/usr/bin/env python3
"""Brave web search for agents.  Usage: websearch "query" [count]"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _web

if len(sys.argv) < 2:
    sys.exit(__doc__)
try:
    count = int(sys.argv[2]) if len(sys.argv) > 2 else 10
except ValueError:
    sys.exit(f"{os.path.basename(sys.argv[0])}: count must be a whole number\n\n{__doc__}")
try:
    print(_web.via_gate("search", {"q": sys.argv[1], "count": count}) if os.environ.get("DMI_GATE")
          else _web.search(sys.argv[1], count))
except _web.WebError as e:
    sys.exit(f"websearch: {e}")
